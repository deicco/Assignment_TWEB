<section id="search-section" class="mb-5 p-4 rounded-4 bg-dark-card shadow">
    <h2 class="text-orange mb-3">Ricerca Film</h2>
    <form action="/" method="GET" class="input-group input-group-lg">
        <input type="text" name="name" class="form-control border-orange" placeholder="Cerca film..." value="{{queryName}}">
        <button class="btn btn-orange px-4 fw-bold" type="submit">Cerca</button>
    </form>
</section>

<div class="row row-cols-1 row-cols-md-2 g-4">
    {{#each moviesData.content}}
        <div class="col">
            <div class="card h-100 movie-card-custom shadow-sm">
                <div class="row g-0 h-100">
                    <div class="col-4">
                        <img src="{{this.posterLink}}" class="img-fluid rounded-start h-100 object-fit-cover" alt="Poster">
                    </div>
                    <div class="col-8">
                        <div class="card-body d-flex flex-column h-100">
                            <h5 class="card-title text-orange fw-bold">{{this.movie.name}}</h5>
                            <p class="card-text text-muted mb-1 small">Anno: {{getYear this.movie.date}}</p>
                            <p class="card-text">
                                <span class="badge bg-orange text-dark">Rating: {{formatRating this.movie.rating}} / 5</span>
                            </p>
                            <div class="mt-auto text-end">
                                <a href="/movie_detail?id={{this.movie.id}}" class="btn btn-outline-orange btn-sm stretched-link">Dettagli →</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {{else}}
        <p class="text-center w-100 py-5">Nessun film trovato.</p>
    {{/each}}
</div>

{{#if moviesData.totalPages}}
    <nav class="mt-5">
        <ul class="pagination justify-content-center">
            <li class="page-item {{#if (eq moviesData.number 0)}}disabled{{/if}}">
                <a class="page-link" href="/?page={{sub moviesData.number 1}}&name={{queryName}}">Precedente</a>
            </li>
            <li class="page-item disabled">
                <span class="page-link text-orange">Pagina {{add moviesData.number 1}} di {{moviesData.totalPages}}</span>
            </li>
            <li class="page-item {{#if (eq (add moviesData.number 1) moviesData.totalPages)}}disabled{{/if}}">
                <a class="page-link" href="/?page={{add moviesData.number 1}}&name={{queryName}}">Successiva</a>
            </li>
        </ul>
    </nav>
{{/if}}