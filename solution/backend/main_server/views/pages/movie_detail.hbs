<div class="mb-4">
    <a href="/" class="btn btn-outline-secondary text-orange border-orange">← Torna alla Lista</a>
</div>

<section class="movie-info" style="overflow: hidden;">
    {{#if posters}}
        <img src="{{posters.0.link}}" alt="Poster" style="max-width: 280px; float: right; margin-left: 20px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.3);">
    {{/if}}
    <h2 class="text-orange">{{movie.name}}</h2>
    <p><strong>Anno:</strong> {{getYear movie.date}} | <strong>Rating:</strong> {{formatRating movie.rating}} / 5</p>
    <p><em>"{{movie.tagline}}"</em></p>
    <p>{{movie.description}}</p>
</section>

<section class="related-data mt-4">
    <h3>👥 Cast Principale</h3>
    <ul class="list-unstyled">
        {{#each cast}}
            <li><strong>{{this.name}}</strong> nel ruolo di <span>{{this.role}}</span></li>
        {{/each}}
    </ul>
</section>

<section class="related-data mt-4">
    <h3 class="text-orange">🎭 Generi</h3>
    <p>{{displayGenres}}</p>
</section>
<section class="related-data mt-4">
    <h3 class="text-orange">🌐 Lingue Disponibili</h3>
    <p>{{displayLanguages}}</p>
</section>

<section class="related-data mt-4">
    <h3 class="text-orange">⭐️ Recensioni (da MongoDB)</h3>
    {{#each reviews}}
        <div class="card bg-dark border-secondary mb-3 p-3">
            <p class="mb-1 text-orange"><strong>{{this.critic_name}}</strong> - Voto: {{this.review_score}}</p>
            <p class="mb-0 small">"{{this.review_content}}"</p>
        </div>
    {{else}}
        <p>Nessuna recensione disponibile per questo film.</p>
    {{/each}}

    {{#if revPagination.total}}
        <nav class="mt-4">
            <ul class="pagination justify-content-center pagination-sm">
                {{!-- Previous Button --}}
                <li class="page-item {{#if (eq revPagination.current 0)}}disabled{{/if}}">
                    <a class="page-link border-orange text-orange bg-dark"
                       href="/movie_detail?id={{movie.id}}&revPage={{sub revPagination.current 1}}">
                    Precedente
                    </a>
                </li>

                {{!-- Page Indicator --}}
                <li class="page-item disabled">
                    <span class="page-link border-orange text-orange bg-dark">
                        Pagina {{add revPagination.current 1}} di {{revPagination.total}}
                    </span>
                </li>

                {{!-- Next Button --}}
                <li class="page-item {{#if (eq (add revPagination.current 1) revPagination.total)}}disabled{{/if}}">
                    <a class="page-link border-orange text-orange bg-dark"
                       href="/movie_detail?id={{movie.id}}&revPage={{add revPagination.current 1}}">
                    Successiva
                    </a>
                </li>
            </ul>
        </nav>
    {{/if}}
</section>

<section id="chat-container" data-movie-id="{{movie.id}}" class="chat-section mt-4 border-top border-secondary pt-3">
    <h3 class="text-orange">💬 Discussione Live</h3>
    <div id="chat-box" style="height: 250px; overflow-y: scroll; background: #000; padding: 15px; border-radius: 8px;"></div>
    <div class="mt-3 d-flex gap-2">
        <input type="text" id="chat-input" class="form-control" placeholder="Scrivi un messaggio...">
        <button class="btn btn-orange" onclick="sendChatMessage()">Invia</button>
    </div>
</section>

<script src="/javascripts/chat.js"></script>
